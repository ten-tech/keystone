root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{rs}]
indent_size = 4
max_line_length = 100

[*.{yaml,yml,json,md,css,html,js}]
indent_size = 2

[*.ps1]
indent_size = 4
end_of_line = crlf
# UTF-8 AVEC BOM, et ce n'est pas un détail de goût : les scripts du dépôt
# ciblent Windows PowerShell 5.1, qui lit un fichier sans BOM comme de l'ANSI.
# Les accents et les tirets cadratin deviennent alors du charabia, et le script
# ne compile même plus. Constaté sur dev-setup.ps1.
charset = utf-8-bom

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
